@startuml sequence_bootstrap
!theme plain
skinparam sequenceMessageAlign center

title Bootstrap: connect, subscribe, seed, render\n(DashboardComponent injects via tokens — sees only the contracts)

actor User
participant "Browser" as Br
participant "DashboardComponent\n(smart-building-demo)" as Dash
participant "ISignalRClient\n(impl: SignalRClient @ api)" as SR
participant "IBackendClient\n(impl: BackendClient @ api)" as BC
participant "BFF" as BFF
participant "IRoomStateStore\n(impl: RoomStateStore @ api)" as RS
participant "ITelemetryStore\n(impl: TelemetryStore @ api)" as TS
participant "components/* widgets" as UI

User -> Br: navigate to /
Br -> Dash: ngOnInit()

note over Dash
  inject(BACKEND_CLIENT)
  inject(SIGNALR_CLIENT)
  inject(ROOM_STATE_STORE)
  inject(TELEMETRY_STORE)
end note

Dash -> SR: start()
SR -> BFF: WS connect /hub
BFF --> SR: connected

Dash -> SR: subscribe(tel.Contracts.TemperatureReading)
Dash -> SR: subscribe(tel.Contracts.OccupancyReading)
Dash -> SR: subscribe(evt.Contracts.RoomOccupancyChanged)
Dash -> SR: subscribe(evt.Contracts.ThermostatChanged)

Dash -> RS: seed()
RS -> BC: query("Contracts.Queries.ListRooms", {})
BC -> BFF: POST /api/queries
BFF --> BC: ListRoomsResult
BC --> RS: rooms[]
RS --> UI: rooms$ → [rooms] Input

== live updates ==

BFF -> SR: OnMessage("tel.Contracts.TemperatureReading", envelope)
SR -> TS: append point
TS --> UI: temperatureSeries$ → [series] Input
UI --> User: chart updates (throttled)

@enduml
